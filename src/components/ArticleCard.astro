---
import { fmtDate, isoDate, readingTime, getCategory, levelsOf, levelLabel, levelSlug, tagSlug, type Article } from '../lib/articles';
import CoverImage from './CoverImage.astro';
import Icon from './Icon.astro';

interface Props {
  article: Article;
  variant?: 'default' | 'slide';
  /** Heading level for the title, so pages keep a valid outline (h2 on pages without section headings). */
  level?: 2 | 3;
  eager?: boolean;
  /** Adds the data attributes the library filter (scripts/library.ts) reads. */
  lib?: boolean;
  /** Stagger index for the reveal animation. */
  i?: number;
}
const { article, variant = 'default', level = 3, eager = false, lib = false, i = 0 } = Astro.props;
const d = article.data;
const cat = getCategory(d.category);
const lv = levelsOf(article);
const mins = readingTime(article.body);
const Heading = `h${level}` as 'h2' | 'h3';

const sizes = {
  default: '(min-width: 1200px) 370px, (min-width: 700px) 46vw, 94vw',
  slide: '(min-width: 1100px) 540px, (min-width: 700px) 38vw, 80vw',
}[variant];
const widths = {
  default: [360, 540, 720, 1080],
  slide: [480, 720, 1080, 1440],
}[variant];
const cls = ['card', `card--${variant}`];
const libAttrs = lib
  ? {
      'data-lib-item': '',
      'data-cat': d.category,
      'data-levels': lv.map(levelSlug).join(' '),
      'data-date': String(d.publishedAt.getTime()),
      'data-mins': String(mins),
      'data-title': d.title.toLowerCase(),
      'data-hay': [d.title, d.description, ...d.tags].join(' ').toLowerCase(),
    }
  : {};
---

<article class:list={cls} style={`--c:${cat?.accent ?? '#0176d3'};--d:${Math.min(i, 8) * 70}ms`} data-reveal data-tilt data-cursor="Read" {...libAttrs}>
  <div class="card__media" data-cover>
    <CoverImage cover={d.cover} category={d.category} sizes={sizes} widths={widths} eager={eager} />
  </div>
  <div class="card__body">
    <div class="card__kicker">
      <span class="tag"><i class="dot"></i>{cat?.short ?? 'Article'}</span>
      <span class="level" data-lv={levelSlug(lv[0])} data-lv-max={levelSlug(lv[lv.length - 1])}>
        <span class="level__bars" aria-hidden="true"><i></i><i></i><i></i></span>{levelLabel(lv)}
      </span>
    </div>
    <Heading class="card__title"><a href={`/articles/${article.id}/`} data-slug={article.id}><span class="u">{d.title}</span></a></Heading>
    <p class="card__desc">{d.description}</p>
    <div class="card__foot">
      <time datetime={isoDate(d.publishedAt)}>{fmtDate(d.publishedAt)} · {mins} min</time>
      <span class="card__go" aria-hidden="true">Read<Icon name="arrow-right" size={14} /></span>
    </div>
  </div>
</article>
