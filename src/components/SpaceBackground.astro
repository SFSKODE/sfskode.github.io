---
// Dark-theme backdrop: a real-time black hole (WebGL), a drifting starfield, shooting stars and a few little original
// space travellers. It is purely decorative (aria-hidden), sits behind all content and is hidden in the light theme.
//
// Want to add your own character art? Put the image in public/space/ and list its URL below, for example
// ['/space/my-character.png']. Only use artwork you have the right to use.
const custom: string[] = [];
---
<div class="space" aria-hidden="true" data-space>
  <canvas class="space__canvas" data-space-canvas></canvas>
  <div class="space__fallback"></div>

  <div class="trav trav--bot" style="--x0:-14vw;--y0:70vh;--x1:112vw;--y1:18vh;--r:-8deg;--t:95s;--d:-12s;--s:92px">
    <svg viewBox="0 0 100 110" class="trav__art" focusable="false">
      <defs>
        <linearGradient id="bot-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eef3ff"/><stop offset="1" stop-color="#9fb4dc"/></linearGradient>
        <radialGradient id="bot-flame" cx=".5" cy="0" r="1"><stop offset="0" stop-color="#fff6c8"/><stop offset=".5" stop-color="#ffa94d"/><stop offset="1" stop-color="#ff5d3b" stop-opacity="0"/></radialGradient>
      </defs>
      <g class="trav__flame"><ellipse cx="50" cy="96" rx="9" ry="14" fill="url(#bot-flame)"/></g>
      <line x1="50" y1="14" x2="50" y2="26" stroke="#9fb4dc" stroke-width="3" stroke-linecap="round"/>
      <circle class="trav__blink" cx="50" cy="11" r="5" fill="#5ee6ff"/>
      <rect x="26" y="26" width="48" height="36" rx="16" fill="url(#bot-body)"/>
      <rect x="32" y="33" width="36" height="21" rx="10" fill="#0d1630"/>
      <circle cx="43" cy="43.5" r="4.2" fill="#5ee6ff"/><circle cx="57" cy="43.5" r="4.2" fill="#5ee6ff"/>
      <rect x="34" y="64" width="32" height="22" rx="10" fill="url(#bot-body)"/>
      <circle cx="50" cy="75" r="4" fill="#ff8a5c"/>
      <rect x="18" y="66" width="12" height="7" rx="3.5" fill="#9fb4dc" transform="rotate(-18 24 69)"/>
      <rect x="70" y="66" width="12" height="7" rx="3.5" fill="#9fb4dc" transform="rotate(18 76 69)"/>
      <rect x="38" y="84" width="9" height="8" rx="3" fill="#7e93bd"/><rect x="53" y="84" width="9" height="8" rx="3" fill="#7e93bd"/>
    </svg>
  </div>

  <div class="trav trav--pod" style="--x0:110vw;--y0:78vh;--x1:-16vw;--y1:34vh;--r:-100deg;--t:120s;--d:-70s;--s:84px">
    <svg viewBox="0 0 100 130" class="trav__art" focusable="false">
      <defs>
        <linearGradient id="pod-body" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#b9c6e4"/></linearGradient>
        <radialGradient id="pod-flame" cx=".5" cy="0" r="1"><stop offset="0" stop-color="#fff6c8"/><stop offset=".5" stop-color="#ffa94d"/><stop offset="1" stop-color="#ff5d3b" stop-opacity="0"/></radialGradient>
      </defs>
      <g class="trav__flame"><ellipse cx="50" cy="116" rx="11" ry="18" fill="url(#pod-flame)"/></g>
      <path d="M22 88 L8 112 L34 100Z" fill="#ff6b6b"/><path d="M78 88 L92 112 L66 100Z" fill="#ff6b6b"/>
      <path d="M50 4 C72 22 76 54 72 100 L28 100 C24 54 28 22 50 4Z" fill="url(#pod-body)"/>
      <path d="M50 4 C58 10 64 18 67 27 L33 27 C36 18 42 10 50 4Z" fill="#ff6b6b"/>
      <circle cx="50" cy="52" r="13" fill="#10224a"/><circle cx="50" cy="52" r="9.5" fill="#5ab0ff"/><circle cx="46" cy="48" r="3" fill="#ffffff" opacity=".7"/>
      <rect x="28" y="84" width="44" height="6" fill="#8ea2cf"/>
    </svg>
  </div>

  <div class="trav trav--sat" style="--x0:20vw;--y0:-12vh;--x1:92vw;--y1:112vh;--r:20deg;--t:140s;--d:-30s;--s:100px">
    <svg viewBox="0 0 140 90" class="trav__art trav__art--spin" focusable="false">
      <defs><linearGradient id="sat-panel" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3a7bff"/><stop offset="1" stop-color="#153d99"/></linearGradient></defs>
      <rect x="4" y="26" width="42" height="38" rx="3" fill="url(#sat-panel)"/><rect x="94" y="26" width="42" height="38" rx="3" fill="url(#sat-panel)"/>
      <path d="M18 26 V64 M32 26 V64 M4 45 H46 M108 26 V64 M122 26 V64 M94 45 H136" stroke="#9cc2ff" stroke-width="1.5" opacity=".7"/>
      <rect x="46" y="42" width="8" height="6" fill="#9fb4dc"/><rect x="86" y="42" width="8" height="6" fill="#9fb4dc"/>
      <rect x="54" y="30" width="32" height="30" rx="6" fill="#dfe7fb"/>
      <rect x="60" y="36" width="20" height="10" rx="3" fill="#0d1630"/><circle class="trav__blink" cx="70" cy="53" r="3" fill="#ffd166"/>
      <path d="M70 30 V16" stroke="#9fb4dc" stroke-width="3"/><path d="M58 14 Q70 4 82 14 Q70 20 58 14Z" fill="#dfe7fb"/>
    </svg>
  </div>

  <div class="trav trav--saucer" style="--x0:-12vw;--y0:30vh;--x1:114vw;--y1:60vh;--r:4deg;--t:80s;--d:-48s;--s:88px">
    <svg viewBox="0 0 120 70" class="trav__art" focusable="false">
      <defs>
        <linearGradient id="sc-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e8eefc"/><stop offset="1" stop-color="#8da2d0"/></linearGradient>
        <radialGradient id="sc-dome" cx=".4" cy=".3" r=".9"><stop offset="0" stop-color="#d9f6ff"/><stop offset="1" stop-color="#4fa3e0"/></radialGradient>
      </defs>
      <path d="M36 30 C36 10 84 10 84 30Z" fill="url(#sc-dome)" opacity=".95"/>
      <circle cx="60" cy="24" r="4" fill="#0d1630"/><circle cx="60" cy="24" r="1.6" fill="#5ee6ff"/>
      <ellipse cx="60" cy="38" rx="52" ry="14" fill="url(#sc-body)"/>
      <ellipse cx="60" cy="34" rx="52" ry="9" fill="#ffffff" opacity=".35"/>
      <circle class="trav__blink" cx="28" cy="40" r="3.2" fill="#ffd166"/><circle cx="60" cy="44" r="3.2" fill="#ff8a5c"/><circle class="trav__blink" cx="92" cy="40" r="3.2" fill="#5ee6ff"/>
      <path d="M44 50 L36 66 M76 50 L84 66" stroke="#8da2d0" stroke-width="3" stroke-linecap="round"/>
    </svg>
  </div>

  <div class="space__veil"></div>
  <div class="space__meteors" data-space-meteors></div>

  {custom.map((src, i) => (
    <div class="trav trav--custom" style={`--x0:-12vw;--y0:${20 + i * 22}vh;--x1:112vw;--y1:${40 + i * 12}vh;--r:0deg;--t:${110 + i * 15}s;--d:-${25 + i * 31}s;--s:96px`}>
      <img class="trav__art" src={src} alt="" width="96" height="96" loading="lazy" decoding="async" />
    </div>
  ))}
</div>
