---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/geist-mono/wght.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import '../styles/base.css';
import '../styles/ui.css';
import '../styles/home.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import Icon from '../components/Icon.astro';
// Floating glass bubbles in the background (fixed numbers, so every build looks the same).
const bubbles = Array.from({ length: 16 }, (_, i) => ({ x: (i * 37 + 9) % 94, s: 16 + ((i * 29) % 50), d: -((i * 7) % 26), t: 20 + ((i * 5) % 16) }));
import { SITE } from '../config/site';
import { safeJson } from '../lib/articles';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL of the social share image. Defaults to /og-default.png. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
  publishedAt?: string;
  updatedAt?: string;
}
const { title, description = SITE.description, image, type = 'website', noindex = false, jsonLd, publishedAt, updatedAt } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Social networks do not render SVG previews, so the default is a PNG.
const ogImage = new URL(image ?? '/og-default.png', Astro.site).toString();
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#eef4ff" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((o) => <script type="application/ld+json" set:html={safeJson(o)} />)}

    <!-- Without JavaScript every tab panel stays readable and the tab buttons are hidden. -->
    <noscript><style>[data-tabpanel][hidden]{display:block!important}.lib-toolbar{display:none!important}[data-reveal],[data-curtain]{opacity:1!important;translate:none!important;clip-path:none!important}.w>span{transform:none!important}</style></noscript>

    <!-- Hold the first render until the whole (small, static) page is parsed, so the shared-cover page transition can find its elements. -->
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline>
      // Arriving page: name the matching cover for the shared-element page transition (Chromium cross-document view transitions).
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var re = /^\/articles\/([^/]+)\/$/, el = null, from = '';
        try { var nav = navigator.activation; from = nav && nav.from ? new URL(nav.from.url).pathname : ''; } catch (x) {}
        if (re.test(location.pathname)) el = document.querySelector('.article__cover');
        else { var m = re.exec(from); if (m) { var a = document.querySelector('a[data-slug="' + m[1].replace(/"/g, '') + '"]'); var c = a && a.closest('.card'); el = c && c.querySelector('[data-cover]'); } }
        if (!el) return;
        el.style.viewTransitionName = 'hero-cover';
        vt.finished.finally(function () { el.style.viewTransitionName = ''; });
      });
    </script>

    <!-- Apply the saved theme before first paint (no flash). Light is the default. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
        try { var f = parseInt(localStorage.getItem('fs') || '0', 10); if (f) d.style.setProperty('--fs', String(1 + Math.max(-2, Math.min(3, f)) * 0.07)); } catch (e) {}
        d.classList.add('js');
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', d.getAttribute('data-theme') === 'dark' ? '#0b0d11' : '#eef4ff');
      })();
    </script>
  </head>
  <body>
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i><s></s><u></u>{bubbles.map((b) => <b style={`--x:${b.x}%;--s:${b.s}px;--d:${b.d}s;--t:${b.t}s`}></b>)}</div>
    <a class="skip" href="#main">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <Palette />
    <button class="totop" type="button" data-totop aria-label="Back to top">
      <svg class="totop__ring" viewBox="0 0 44 44" aria-hidden="true" focusable="false"><circle class="totop__track" cx="22" cy="22" r="19" /><circle class="totop__bar" cx="22" cy="22" r="19" pathLength="100" /></svg>
      <Icon name="arrow-up" size={18} />
    </button>
    <div class="cursor" data-cursor-root aria-hidden="true"><i class="cursor__dot"></i><span class="cursor__disc"></span></div>
    <div class="sr-only" role="status" aria-live="polite" id="sr-status"></div>

    <i id="page-end" hidden></i>
    <script>
      import '../scripts/core';
      import '../scripts/motion';
    </script>
    {SITE.cloudflareAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}></script>
    )}
  </body>
</html>
